# Cloudflare R2 credentials (required for cloud training & dataset sync)
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket

# Optional overrides
# R2_TRAIN_PREFIX=train
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# D1_DATABASE_ID=<d1-database-uuid>
# CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>  # optional if derivable from R2_ENDPOINT_URL
# PRODUCTION_MODEL_PATH=/path/to/sleep_classifier_ensemble.pt
